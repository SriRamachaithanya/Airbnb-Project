<% layout("/layouts/boilerplate") %>

<div class="container text-center py-5 my-5" style="max-width: 650px;">
  <div class="d-inline-flex p-4 rounded-circle bg-danger-subtle text-danger mb-3">
    <i class="fa-solid fa-triangle-exclamation fs-1"></i>
  </div>
  <h2 class="fw-bold mb-2">Something went wrong</h2>
  <div class="alert alert-danger border-0 rounded-4 p-3 my-3 text-start">
    <strong>Error <%= typeof statusCode !== 'undefined' ? statusCode : '500' %>:</strong>
    <span class="d-block mt-1"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></span>
    <% if (typeof stack !== 'undefined' && stack) { %>
      <pre class="mt-2 small bg-dark text-white p-2 rounded overflow-auto" style="max-height: 150px;"><%= stack %></pre>
    <% } %>
  </div>
  <div class="d-flex justify-content-center gap-3 mt-4">
    <a href="/listings" class="btn btn-airbnb rounded-pill px-4">Back to Home</a>
    <a href="javascript:history.back()" class="btn btn-outline-dark rounded-pill px-4">Go Back</a>
  </div>
</div>
