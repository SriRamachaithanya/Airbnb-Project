<% layout("/layouts/boilerplate") %>

<div class="container my-5" style="max-width: 860px;">
  <div class="card border rounded-4 shadow-sm p-4 p-md-5 bg-white">
    <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4 flex-wrap gap-2">
      <div>
        <span class="badge bg-danger text-white rounded-pill px-3 py-1 mb-2">Reservation Receipt</span>
        <h2 class="fw-bold mb-1">Booking Confirmation</h2>
        <p class="text-secondary small mb-0">Booking Reference: <span class="fw-mono text-dark fw-bold">#<%= booking._id %></span></p>
      </div>
      <div class="text-md-end">
        <span class="badge <%= booking.status === 'confirmed' ? 'bg-success' : (booking.status === 'cancelled' ? 'bg-danger' : 'bg-warning') %> text-white fs-6 px-3 py-2 rounded-pill">
          <%= booking.status.toUpperCase() %>
        </span>
      </div>
    </div>

    <!-- Property Details Box -->
    <div class="row g-4 mb-4 pb-4 border-bottom align-items-center">
      <div class="col-12 col-md-4">
        <img 
          src="<%= (booking.listing && booking.listing.images && booking.listing.images[0]) ? booking.listing.images[0].url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>" 
          alt="<%= booking.listing ? booking.listing.title : 'Listing' %>" 
          class="img-fluid rounded-3 shadow-sm w-100" 
          style="height: 160px; object-fit: cover;"
        >
      </div>
      <div class="col-12 col-md-8">
        <h4 class="fw-bold mb-1"><%= booking.listing ? booking.listing.title : 'Listing' %></h4>
        <p class="text-secondary mb-2"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= booking.listing ? booking.listing.location : '' %>, <%= booking.listing ? booking.listing.country : '' %></p>
        <% if (booking.listing && booking.listing.owner) { %>
          <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3 small">
            <i class="fa-solid fa-user-tie text-secondary"></i>
            <span>Hosted by <strong><%= booking.listing.owner.name %></strong> (<%= booking.listing.owner.email %>)</span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Stay Details Grid -->
    <div class="row g-3 mb-4 pb-4 border-bottom">
      <div class="col-6 col-md-3">
        <div class="text-secondary small fw-bold">CHECK-IN</div>
        <div class="fw-bold fs-6"><%= new Date(booking.checkIn).toDateString() %></div>
        <div class="text-muted small">After 2:00 PM</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-secondary small fw-bold">CHECKOUT</div>
        <div class="fw-bold fs-6"><%= new Date(booking.checkOut).toDateString() %></div>
        <div class="text-muted small">Before 11:00 AM</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-secondary small fw-bold">DURATION</div>
        <div class="fw-bold fs-6"><%= booking.nights %> Nights</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-secondary small fw-bold">GUESTS</div>
        <div class="fw-bold fs-6"><%= booking.guests %> Guests</div>
      </div>
    </div>

    <!-- Price Breakdown Table -->
    <h5 class="fw-bold mb-3">Price Breakdown</h5>
    <div class="bg-light p-3 rounded-3 mb-4">
      <div class="d-flex justify-content-between mb-2">
        <span>&#8377;<%= Number(booking.pricePerNight).toLocaleString("en-IN") %> x <%= booking.nights %> nights</span>
        <span>&#8377;<%= Number(booking.pricePerNight * booking.nights).toLocaleString("en-IN") %></span>
      </div>
      <div class="d-flex justify-content-between mb-2">
        <span>Cleaning fee</span>
        <span>&#8377;<%= Number(booking.cleaningFee).toLocaleString("en-IN") %></span>
      </div>
      <div class="d-flex justify-content-between mb-2">
        <span>Wanderlust service fee</span>
        <span>&#8377;<%= Number(booking.serviceFee).toLocaleString("en-IN") %></span>
      </div>
      <% if (booking.discount > 0) { %>
        <div class="d-flex justify-content-between mb-2 text-success fw-semibold">
          <span>Long-stay discount</span>
          <span>-&#8377;<%= Number(booking.discount).toLocaleString("en-IN") %></span>
        </div>
      <% } %>
      <hr class="my-2">
      <div class="d-flex justify-content-between fw-bold fs-5 text-dark">
        <span>Total Paid</span>
        <span>&#8377;<%= Number(booking.totalPrice).toLocaleString("en-IN") %></span>
      </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2">
      <a href="/my-trips" class="btn btn-outline-dark rounded-pill px-4">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Trips
      </a>
      <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary rounded-pill" onclick="window.print()">
          <i class="fa-solid fa-print me-1"></i> Print Receipt
        </button>
        <% if (booking.status === 'confirmed') { %>
          <form method="POST" action="/bookings/<%= booking._id %>/cancel" class="m-0" onsubmit="return confirm('Cancel this booking?');">
            <button class="btn btn-danger rounded-pill px-4">Cancel Reservation</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
