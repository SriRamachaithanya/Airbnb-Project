<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-5">
  <div class="col-12 col-sm-10 col-md-8 col-lg-6">
    <div class="card border rounded-4 shadow-sm p-4 p-md-5 bg-white">
      <div class="text-center mb-4">
        <div class="d-inline-flex p-3 rounded-circle bg-danger-subtle text-danger mb-2">
          <i class="fa-solid fa-user-plus fs-4"></i>
        </div>
        <h3 class="fw-bold">Create an account</h3>
        <p class="text-secondary small">Join Wanderlust to explore homes or host your own space.</p>
      </div>

      <form method="POST" action="/register" class="needs-validation">
        <div class="mb-3">
          <label for="name" class="form-label fw-semibold">Full Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-control rounded-3 py-2" 
            placeholder="e.g. Jane Doe" 
            required 
            autofocus
          >
        </div>

        <div class="mb-3">
          <label for="email" class="form-label fw-semibold">Email address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-control rounded-3 py-2" 
            placeholder="you@example.com" 
            required
          >
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="password" class="form-label fw-semibold">Password</label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-control rounded-3 py-2" 
              placeholder="At least 6 characters" 
              minlength="6"
              required
            >
          </div>

          <div class="col-md-6">
            <label for="role" class="form-label fw-semibold">Account Role</label>
            <select id="role" name="role" class="form-select rounded-3 py-2">
              <option value="guest" selected>Guest (Explore & Book)</option>
              <option value="host">Host (List Properties)</option>
            </select>
          </div>
        </div>

        <div class="mb-4">
          <label for="phone" class="form-label fw-semibold">Phone Number (Optional)</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            class="form-control rounded-3 py-2" 
            placeholder="+91 98765 43210"
          >
        </div>

        <button type="submit" class="btn btn-airbnb w-100 py-2 fs-6 rounded-3 fw-bold mb-3">
          Create Account
        </button>

        <div class="text-center text-secondary small">
          Already have an account? <a href="/login" class="text-danger fw-bold text-decoration-underline">Log in</a>
        </div>
      </form>
    </div>
  </div>
</div>
