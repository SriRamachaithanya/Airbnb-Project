<% if (success && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show my-3 shadow-sm d-flex align-items-center" role="alert">
    <i class="fa-solid fa-circle-check me-2 fs-5"></i>
    <div class="flex-grow-1"><%= success %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show my-3 shadow-sm d-flex align-items-center" role="alert">
    <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
    <div class="flex-grow-1"><%= error %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
